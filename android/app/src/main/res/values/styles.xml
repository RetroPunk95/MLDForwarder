<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MLDForwarder" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="InputField" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button.Colored">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/surface_alt</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
</resources>
