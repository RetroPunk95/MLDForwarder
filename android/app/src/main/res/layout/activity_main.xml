<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_brand_icon"
            android:padding="9dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/app_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MLDForwarder"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Telegram Sync"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerRouteCountText"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="0"
            android:textColor="@color/primary_light"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/homePanel"
            layout="@layout/screen_home" />

        <include
            android:id="@+id/routesPanel"
            layout="@layout/screen_routes"
            android:visibility="gone" />

        <include
            android:id="@+id/activityPanel"
            layout="@layout/screen_activity"
            android:visibility="gone" />

        <include
            android:id="@+id/accountPanel"
            layout="@layout/screen_account"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_bottom_nav"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/BottomNavItem"
            android:background="@drawable/bg_nav_selected">

            <ImageView
                android:id="@+id/navHomeIcon"
                style="@style/BottomNavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/navHomeLabel"
                style="@style/BottomNavLabel"
                android:text="Início"
                android:textColor="@color/primary_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRoutes"
            style="@style/BottomNavItem">

            <ImageView
                android:id="@+id/navRoutesIcon"
                style="@style/BottomNavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_routes" />

            <TextView
                android:id="@+id/navRoutesLabel"
                style="@style/BottomNavLabel"
                android:text="Rotas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navActivity"
            style="@style/BottomNavItem">

            <ImageView
                android:id="@+id/navActivityIcon"
                style="@style/BottomNavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_activity" />

            <TextView
                android:id="@+id/navActivityLabel"
                style="@style/BottomNavLabel"
                android:text="Atividade" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAccount"
            style="@style/BottomNavItem">

            <ImageView
                android:id="@+id/navAccountIcon"
                style="@style/BottomNavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_account" />

            <TextView
                android:id="@+id/navAccountLabel"
                style="@style/BottomNavLabel"
                android:text="Conta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
